---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const translations = useTranslations(lang);

interface Props {
  title: string;
}

const { title } = Astro.props;
console.log({ lang, trans: translations("about"), title });
---

<div class="bg-slate-800">
  <h2 class="text-white text-2xl font-bold text-center py-8">
    {translations("about.title")}
  </h2>
  <div class="text-white text-lg px-16">
    {
      translations("about").map((text: string) => {
        return <p class="py-4">{text}</p>;
      })
    }
  </div>
</div>
